# Handloom Artisan Support Platform - Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/handloom_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/handloom_artisan_platform?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=replace_with_a_strong_64_char_random_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend CORS Origin URL
# In local development: http://localhost:5173
# In production on Vercel: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials (Test Mode)
# Obtain test credentials from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Initial Administrator Bootstrap Credentials (Used for 'npm run bootstrap:admin')
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@handloom-artisan.org
ADMIN_PASSWORD=SetAStrongPassword123!
